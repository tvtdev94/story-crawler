{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@story-crawler/db": ["./packages/db/src/index.ts"],
      "@story-crawler/db/*": ["./packages/db/src/*"],
      "@story-crawler/core": ["./packages/core/src/index.ts"],
      "@story-crawler/core/*": ["./packages/core/src/*"]
    }
  }
}
