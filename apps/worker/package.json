{
  "name": "@story-crawler/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "start": "dotenv -e ../../.env -- tsx src/index.ts",
    "build": "tsc --noEmit",
    "lint": "echo \"(worker) lint placeholder\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
