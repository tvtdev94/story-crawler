{
  "name": "tram-tuyen",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --stream dev",
    "dev:web": "pnpm --filter @tram-tuyen/web dev",
    "dev:worker": "pnpm --filter @tram-tuyen/worker dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @tram-tuyen/db generate",
    "db:migrate": "pnpm --filter @tram-tuyen/db migrate",
    "db:migrate:deploy": "pnpm --filter @tram-tuyen/db migrate:deploy",
    "db:reset": "pnpm --filter @tram-tuyen/db reset",
    "db:seed": "pnpm --filter @tram-tuyen/db seed",
    "db:studio": "pnpm --filter @tram-tuyen/db studio",
    "compose:up": "docker compose -f docker/docker-compose.yml up -d",
    "compose:down": "docker compose -f docker/docker-compose.yml down",
    "compose:logs": "docker compose -f docker/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
